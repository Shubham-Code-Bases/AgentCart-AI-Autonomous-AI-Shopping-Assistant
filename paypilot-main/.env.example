# AgentCart AI Environment Configuration (copy to .env and fill in)
# Product: AgentCart AI - Your AI-Powered Autonomous Shopping Assistant
# Shop Smarter. Compare Better. Pay Securely.

# --- PayPal Mode -------------------------------------------------------
# mock  = offline in-process mock (default, zero credentials needed)
# live  = PayPal sandbox (https://api-m.sandbox.paypal.com)
AGENTCART_PAYPAL_MODE=mock
PAYPILOT_PAYPAL_MODE=mock

# --- PayPal Sandbox Credentials (live mode) -----------------------------
# Create a free sandbox REST app at https://developer.paypal.com/
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- LLM Brain (optional) ----------------------------------------------
# Any OpenAI-compatible chat endpoint. If unreachable or unset, AgentCart AI
# falls back to its deterministic offline heuristic engine automatically.
AGENTCART_LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
AGENTCART_LLM_API_KEY=
AGENTCART_LLM_MODEL=mimo-v2-flash

# Legacy PayPilot environment variable fallbacks (fully supported):
PAYPILOT_LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
PAYPILOT_LLM_API_KEY=
PAYPILOT_LLM_MODEL=mimo-v2-flash
